# ==============================================================================
# LifeLink 2.0 — Environment Configuration Blueprint
# ==============================================================================
# Copy this file to backend/.env and frontend/.env (or set variables accordingly)
# Zero-cost development baseline: All core workflows run with ₹0 external API spend.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------

# Application Environment ('development' | 'test' | 'production')
NODE_ENV="development"

# Server Listen Port
PORT=5000

# PostgreSQL Connection String (REQUIRED for database operations)
# Local setup: Install PostgreSQL, create database 'lifelink', and provide credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lifelink?schema=public"

# Cross-Origin Resource Sharing (CORS)
# Comma-separated allowed origins in production. (In development, all localhost ports are permitted).
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# JWT Authentication Secrets (REQUIRED in production)
# In development, secure default fallbacks are provided. In production, server fails closed if unset.
JWT_SECRET="replace_with_a_secure_random_64_char_hex_secret_in_production"
JWT_REFRESH_SECRET="replace_with_a_second_secure_random_64_char_hex_secret"

# Super Admin 2FA TOTP Secret (REQUIRED for Super Admin login)
# A shared Base32 or ASCII secret used to generate and verify 6-digit TOTP codes.
SUPER_ADMIN_TOTP_SECRET="SUPERADMINSECRET123"

# Google Gemini AI Integration (OPTIONAL — ₹0 free tier eligible)
# If omitted, LifeLink gracefully falls back to an offline rule-based domain assistant.
# Obtain a free key at: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Twilio SMS Alerts & Phone OTP (OPTIONAL — ₹0 local development default)
# If omitted, phone OTP verification logs to console in sandbox mode with explicit notice.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Email OTP & Transactional Email (OPTIONAL — ₹0 local development default)
# Supports SMTP (SendGrid, Mailgun, Brevo, AWS SES, Resend SMTP, or standard Gmail SMTP).
# If omitted, email verification codes log to console in sandbox mode with explicit notice.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_FROM="LifeLink Emergency Network <no-reply@lifelink.org>"

# Google OAuth Client ID (OPTIONAL)
# If omitted, password-based authentication remains active for all roles.
GOOGLE_CLIENT_ID=""

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------

# Backend API Base URL
VITE_API_URL="http://localhost:5000/api"

# Real-Time WebSocket Server URL
VITE_WS_URL="http://localhost:5000"

# Optional Frontend Integrations
VITE_GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_CLIENT_ID=""
