# ==============================================================================
# LifeLink Frontend Configuration (.env.example)
# ₹0 Zero-Cost Open Source Map Stack (Leaflet + OpenStreetMap / CARTO + OSRM)
# ==============================================================================

# Backend API Endpoint
VITE_API_URL="http://localhost:5000/api"

# Real-Time WebSocket Server (Socket.IO)
VITE_WS_URL="http://localhost:5000"

# Map Tile Provider (Optional — Defaults to CARTO Dark Matter & OpenStreetMap Standard)
# Pre-configured tile services:
# CARTO Dark:     https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
# OpenStreetMap:  https://tile.openstreetmap.org/{z}/{x}/{y}.png
# CARTO Positron: https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
VITE_MAP_TILE_URL="https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png"
VITE_MAP_TILE_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors &copy; <a href=\"https://carto.com/attributions\">CARTO</a>"

# Open-Source Road Routing Engine (Optional — Defaults to public OSRM)
VITE_OSRM_ROUTING_URL="https://router.project-osrm.org/route/v1/driving"

# Open-Source Geocoding Service (Optional — Defaults to OpenStreetMap Nominatim)
VITE_GEOCODING_URL="https://nominatim.openstreetmap.org/search"
VITE_REVERSE_GEOCODING_URL="https://nominatim.openstreetmap.org/reverse"

# Optional External Map Providers (NOT MANDATORY — System falls back to OSRM and Haversine)
VITE_MAPBOX_TOKEN=""
VITE_GOOGLE_CLIENT_ID=""

# Supabase Authentication & Realtime Configuration
# Obtain from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
