# ==============================================================================
# LifeLink Backend Configuration (.env)
# ==============================================================================

# Application Environment ('development' | 'test' | 'production')
NODE_ENV="development"

# Port on which the Express API & Socket.IO server listens
PORT=5000

# PostgreSQL Connection String (REQUIRED for shared multi-device source of truth)
# Option A: Local PostgreSQL:
# DATABASE_URL="postgresql://shourya@127.0.0.1:5432/lifelink"
# Option B: Supabase Connection Pooler (Production / Render):
# DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL="postgresql://shourya@127.0.0.1:5432/lifelink"
USE_IN_MEMORY_DB="false"

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# JWT Secrets (REQUIRED in production)
JWT_SECRET="replace_with_a_secure_random_64_char_hex_secret_in_production"
JWT_REFRESH_SECRET="replace_with_a_second_secure_random_64_char_hex_secret"

# Super Admin 2FA TOTP Secret (REQUIRED for Super Admin login)
SUPER_ADMIN_TOTP_SECRET="SUPERADMINSECRET123"

# Google Gemini AI (OPTIONAL — ₹0 Free Tier eligible)
# Leave blank to use built-in offline triage assistant
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Twilio SMS Service (OPTIONAL — Local console mock default)
# Leave blank to safely log dispatched SMS messages to stdout
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Google OAuth Authentication (OPTIONAL)
GOOGLE_CLIENT_ID=""

# Geospatial & Road Routing Engine (OPTIONAL — Defaults to OpenStreetMap OSRM)
OSRM_ROUTING_URL="https://router.project-osrm.org/route/v1/driving"
MAPBOX_ACCESS_TOKEN=""

# NANI Conversational AI & Dual-Provider Configuration
# Provider selection: 'auto' | 'groq' | 'ollama' | 'local_fallback'
NANI_PROVIDER="auto"

# Local Ollama Configuration (₹0 Local-First Inference)
NANI_LOCAL_MODEL="qwen3:4b"
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Groq Hosted AI Provider (OPTIONAL — Cloud inference with free tier quotas)
# Sign up at https://console.groq.com/ to obtain an API key.
# Stored strictly on the backend; never exposed to frontend or public internet.
GROQ_API_KEY=""
NANI_GROQ_MODEL="openai/gpt-oss-20b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# NVIDIA NIM Hosted AI Provider (OPTIONAL — Cloud inference or local NVIDIA RTX runtime)
# Sign up at https://build.nvidia.com/ to obtain an API key.
# Leave blank to preserve mandatory ₹0 AI expenditure.
NVIDIA_API_KEY=""
NANI_NVIDIA_MODEL="nvidia/nemotron-3.5-bolt-e4b"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# Ollama Execution Tuning (milliseconds)
OLLAMA_TIMEOUT_MS=35000

# Supabase Server-Side Token Verification & Auth Integration
# Configured in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"
# Optional service role key if server-side administrative user operations are needed
SUPABASE_SERVICE_ROLE_KEY=""

